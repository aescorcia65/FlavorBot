<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="anchorPane" prefHeight="1080.0" prefWidth="1920.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.farmingdale.recipegenerator.PreferencesController">

    <!-- Full-screen background image -->
    <ImageView fx:id="backgroundImageView"
               AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
               AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">
        <image>
            <Image url="@../../../images/preferences.png" />
        </image>
    </ImageView>

    <!-- Title centered at top -->
    <HBox AnchorPane.topAnchor="30" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" alignment="CENTER">
        <Label text="Select Your Preferences"
               style="-fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:white;"/>
    </HBox>

    <!-- Preferences fields -->
    <HBox fx:id="hBoxholder" style="-fx-background-color: rgba(255, 255, 255, 0.3);
       -fx-background-radius: 15;
       -fx-padding: 20;"
          AnchorPane.topAnchor="100" AnchorPane.leftAnchor="320"
          prefWidth="1300" prefHeight="700" spacing="20">
        <!-- Labels Column -->
        <VBox spacing="40">
            <Label text="Dietary Preferences:" style="-fx-text-fill:white;"/>
            <Label text="Meal Type:" style="-fx-text-fill:white;"/>
            <Label text="Spice Level:" style="-fx-text-fill:white;"/>
            <Label text="Cooking Skills:" style="-fx-text-fill:white;"/>
            <Label text="Food Style:" style="-fx-text-fill:white;"/>
            <Label text="Food Allergies:" style="-fx-text-fill:white;"/>
        </VBox>

        <!-- Inputs Column 1 -->
        <VBox spacing="30">
            <ComboBox fx:id="dietaryPreferencesComboBox" prefWidth="200" />
            <ComboBox fx:id="mealTypeComboBox" prefWidth="200" />
            <ComboBox   fx:id="spiceLevelSlider" prefWidth="200"/>
            <ComboBox fx:id="skillsComboBox" prefWidth="200" />
            <ComboBox fx:id="foodStyleComboBox" prefWidth="200" />
            <TextArea fx:id="allergiesTextArea" prefWidth="200" prefHeight="100" wrapText="true" promptText="Eg. Lactose, Gluten" />
        </VBox>

        <!-- Spacer -->
        <VBox prefWidth="50" />

        <!-- Labels Column 2 -->
        <VBox spacing="40">
            <Label text="Portion Size:" style="-fx-text-fill:white;"/>
            <Label text="Number of Servings:" style="-fx-text-fill:white;"/>
            <Label text="Cooking Time:" style="-fx-text-fill:white;"/>
            <Label text="Flavor:" style="-fx-text-fill:white;"/>
            <Label text="Kitchen Messiness:" style="-fx-text-fill:white;"/>
            <Label text="Additional Notes:" style="-fx-text-fill:white;"/>
        </VBox>

        <!-- Inputs Column 2 -->
        <VBox spacing="30">
            <ComboBox fx:id="portionSizeComboBox" prefWidth="200" />
            <ComboBox fx:id="numServingComboBox" prefWidth="200" />
            <ComboBox fx:id="cookingTimeComboBox" prefWidth="200" />
            <ComboBox fx:id="flavorComboBox" prefWidth="200" />
            <ComboBox fx:id="messComboBox" prefWidth="200" />
            <TextArea fx:id="notesTextArea" prefWidth="200" prefHeight="100" wrapText="true" promptText="Eg. Low Cal, High Prot" />
        </VBox>
    </HBox>

    <!-- Update button centered at bottom -->
    <HBox AnchorPane.bottomAnchor="30" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" alignment="CENTER">
        <Button fx:id="updateButton" text="Update Preferences" onAction="#handleContinueButtonAction"
                prefWidth="200" prefHeight="40"
                style="-fx-font-size:16px; -fx-background-radius:20;"/>
    </HBox>
</AnchorPane>
